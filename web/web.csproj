<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- The user's assembly is loaded at run time, so the trimmer cannot see
         what it needs and would remove types it depends on. Until the trimmer
         roots are pinned to the reference set the compile service advertises,
         publishing untrimmed is the only correct option. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- The runtime runs on a worker thread, which is what lets a program
         block reading a line: Console.ReadLine is synchronous, and the
         browser's main thread cannot both block and collect the keystroke.
         It also means the page repaints while a program runs, so output
         appears as it is written rather than all at once at the end.

         The page must be cross-origin isolated for this to start at all,
         because the wasm heap becomes a SharedArrayBuffer. nginx sends the
         headers that grant that, for this site and for the documentation site
         that frames it - a frame is isolated only when its framer is.

         Building it needs the multithreaded runtime pack, which comes with the
         wasm-tools workload rather than with the SDK. Without it the build
         succeeds and the runtime aborts at startup with
         mono_wasm_start_deputy_thread_async() failed. -->
    <WasmEnableThreads>true</WasmEnableThreads>

  </PropertyGroup>

  <!-- The template fingerprints every *.js. Monaco ships an AMD loader that
       fetches its own files by exact name, so fingerprinting them makes the
       published site 404 on every Monaco module while the dev server, which
       serves original names, keeps working. -->

  <!-- The ghūl runtime is a fixed part of the host: only the user's own
       assembly is loaded dynamically. The compile service compiles against
       this same version, so a program that compiles is a program the browser
       can bind.

       ExcludeAssets matters: the package also carries the ghūl MSBuild
       targets, and importing those into a C# project makes it try to compile
       this project with the ghūl compiler. -->
  <ItemGroup>
    <PackageReference Include="ghul.runtime" Version="24.1.0" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <!-- Drawing, which the compile service also compiles against. It is here so
       the browser has the assembly to bind against: the reference sets the two
       sides use have to be the same list, or a program that compiles fails to
       load. Nothing in this project names it, so the reference exists only to
       put it in the published output. -->
  <ItemGroup>
    <PackageReference Include="ghul.raster" Version="0.11.0" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <!-- The runner, in ghūl. Everything the host does beyond satisfying the
       source generator lives there. -->
  <ItemGroup>
    <ProjectReference Include="../runner/runner.ghulproj" />
  </ItemGroup>

  <!-- Monaco is staged by `npm install`, not committed, so a publish from a
       fresh checkout that skipped it produces a site with no editor and no
       error. Deploying that over a working one with a deleting rsync removes
       the editor from the live site, which is how this was found. -->
  <!-- Before a plain build as well as before a publish. `dotnet run` does not
       publish, so without this the dev server comes up serving a site with no
       editor and no error, and everything downstream fails in ways that look
       like whatever you were working on. -->
  <Target Name="EnsureMonacoIsStaged" BeforeTargets="PrepareForPublish;Build">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/vs/loader.js')"
           Text="Monaco is not staged into web/wwwroot/vs. Run 'npm install' at the repository root first." />
  </Target>

</Project>
