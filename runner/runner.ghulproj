<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
    <GhulOptions>--library</GhulOptions>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="src/**/*.ghul" />
  </ItemGroup>

  <!-- The ghūl MSBuild targets ship inside the runtime package, so this
       reference is what makes the project build at all, not just what
       supplies the runtime assembly. -->
  <ItemGroup>
    <PackageReference Include="ghul.runtime" Version="24.0.1" />
    <!-- The interactive session's logic, shared with the terminal REPL. -->
    <PackageReference Include="ghul.repl" Version="0.38.0" />
  </ItemGroup>
</Project>
