namespace Playground is
    use IO.Std.write_line;

    // Loads an assembly the compiler produced, runs it, and hands back what it
    // wrote.
    //
    // The C# side of the wasm host exists only to satisfy the JSExport source
    // generator, and reaches this through reflection rather than by naming it,
    // because a ghūl assembly cannot be bound against from C# (see
    // docs/design.md). So this is reached by name: Playground.RUNNER.run and
    // Playground.RUNNER.run_cell, taking strings and returning one.
    class RUNNER is
        // Created before the first run and kept, because the page holds the
        // addresses of its buffers and has no way to be told they have moved.
        _channel: CHANNEL? static;

        // The address of the control block, which is all the page is told
        // directly - the buffers' own addresses are in the block. Called once,
        // before anything is run.
        open_channel() -> int static is
            let channel = _channel ?? CHANNEL();

            _channel = channel;

            channel.address
        si

        // The channel, once the page has opened it, for an interactive
        // session's cells to write through as well.
        channel: CHANNEL? static => _channel;

        // Set for the program to read, saying that each picture it shows is
        // on the page as soon as it is shown. A program that animates takes
        // its frame delay from this, so the same program run anywhere else -
        // under test, or on a terminal - does not wait between frames nobody
        // is watching.
        LIVE_IMAGES: string static => "GHUL_LIVE_IMAGES";

        // `{"text": ...}`: everything the program wrote. The page takes the
        // image markers out of it and shows the pictures they name, which it
        // can do while the program is still running - see
        // web/wwwroot/live-output.js.
        run(base64: string, arguments: string) -> string static is
            try
                let assembly =
                    System.Reflection.Assembly.load(
                        System.Convert.from_base64_string(base64));

                let entry = assembly.entry_point;

                if !entry? then
                    return _respond("assembly has no entry point", null, null);
                fi

                // A ghūl `entry()` takes no arguments, but the emitted entry
                // point is free to declare the ARRAY[string] form, so match what
                // is there.
                let parameters: ARRAY[object]? =
                    if entry.get_parameters().count > 0 then
                        [cast object(_command_line(arguments))]
                    else
                        null
                    fi;

                let outcome =
                    _capture(() -> object? => entry.invoke(null, parameters));

                if let status = outcome.value then
                    return _respond(
                        "{outcome.text}[exit status {status}]\n", null, null);
                fi

                return _respond(outcome.text, null, outcome.error);
            catch e: System.Exception
                return _respond(
                    "host error: {e.get_type().name}: {e.message}", null, null);
            yrt
        si

        // The arguments the page is running the program with, each followed by
        // a newline.
        //
        // A newline ends them because no argument can contain one: the page's
        // field is a single line, and a task's run.args is one argument a
        // line. Ending rather than separating is what tells no arguments from
        // one empty argument, which joining would render alike. Anything
        // richer would be a second quoting rule to keep in step with the
        // field's own.
        _command_line(arguments: string) -> ARRAY[string] static is
            if arguments.length == 0 then
                return System.Array.empty[string]();
            fi

            // Every argument is followed by a newline, so the last one ends
            // the string: dropping it is what keeps a trailing empty argument
            // from becoming two.
            return arguments[0..arguments.length - 1].split(['\n']);
        si

        // Every cell of the one interactive session, loaded into one context
        // so that a later cell's reference to an earlier one resolves to the
        // assembly already running rather than to a second copy of it. A wasm
        // runtime cannot unload, so there is no reset here: a new session is
        // a new runtime, which the page gets by replacing the cell host.
        _session: SESSION? static;

        // One step of an interactive session, compiled with
        // `--submission <submission>` against the cells before it. The cell's
        // top-level statements run once, here, through the private entry the
        // compiler writes for a host to call: the public `entry` wants a
        // Ghul.Environment, which a host has no way to make.
        //
        // `{"text": ..., "value": ...}`, where `value` is what the cell's
        // final expression evaluated to, and is absent when the cell ended on
        // a statement or its value was null. A cell that throws answers with
        // what it wrote, and `error` names the exception; the cells before it
        // are unaffected.
        run_cell(base64: string, submission: string) -> string static is
            try
                let session = _session ?? SESSION();

                _session = session;

                let assembly =
                    session.add(System.Convert.from_base64_string(base64));

                // A cell of nothing but definitions has no statements to run,
                // and so no entry: loading it is all there is to do.
                let globals = assembly.get_type("{submission}.$globals");

                if !globals? then
                    return _respond("", null, null);
                fi

                let entry = globals.get_method(
                    "_entry",
                    System.Reflection.BindingFlags.PUBLIC |
                    System.Reflection.BindingFlags.NON_PUBLIC |
                    System.Reflection.BindingFlags.STATIC);

                if !entry? then
                    return _respond("", null, null);
                fi

                let arguments = [cast object(System.Array.empty[string]())];

                let outcome =
                    _capture(() -> object? => entry.invoke(null, arguments));

                return _respond(
                    outcome.text, outcome.value?.to_string(), outcome.error);
            catch e: System.Exception
                return _respond(
                    "host error: {e.get_type().name}: {e.message}", null, null);
            yrt
        si

        // Runs `call` with standard output redirected: without this the
        // program's output goes to the browser console, where the page cannot
        // show it. An exception the program throws is written into the output
        // as well as returned, so a page showing only the text still says what
        // happened.
        _capture(call: () -> object?)
            -> (text: string, value: object?, error: string?) static
        is
            let writer = IO.StringWriter();
            let previous = IO.Std.out;
            let previous_error = IO.Std.error;

            let channel = _channel;

            if channel? then
                let out = CONSOLE_OUT(channel, writer);

                IO.Std.set_out(out);
                IO.Std.set_error(out);
                IO.Std.set_in(CONSOLE_IN(channel, out));
            else
                IO.Std.set_out(writer);
                IO.Std.set_error(writer);
            fi

            System.Environment.set_environment_variable(LIVE_IMAGES, "1");

            let value: object? mut = null;
            let error: string? mut = null;

            try
                value = call();
            catch e: System.Reflection.TargetInvocationException
                let inner = e.inner_exception;

                let described =
                    if inner? then _describe(inner)
                    else "[unhandled: {e.message}]"
                    fi;

                writer.write_line(described);
                error = described;
            finally
                IO.Std.set_out(previous);
                IO.Std.set_error(previous_error);

                // Set rather than put back: reading IO.Std.in is what throws
                // in a browser, where there is no such stream to hand back,
                // so there is nothing to have saved.
                IO.Std.set_in(IO.TextReader.`null);
            yrt

            return (text = writer.to_string(), value = value, error = error);
        si


        // The browser host has no standard input: reading it throws
        // PlatformNotSupportedException with a generic message that gives no
        // hint why. A program that never read standard input can hit the same
        // exception for an unrelated reason, so the stack trace rather than
        // the type is what tells the two apart.
        _describe(e: System.Exception) -> string static is
            if isa System.PlatformNotSupportedException(e) /\ (e.stack_trace ?? "").contains("Console") then
                return "[unhandled: this program reads from standard input, which the playground does not support]";
            fi

            "[unhandled: {e.get_type().name}: {e.message}]"
        si

        // Written rather than serialized from an object: a writer needs no
        // reflection, which is one less thing to depend on being enabled in a
        // wasm host.
        _respond(text: string, value: string?, error: string?) -> string static is
            let buffer = IO.MemoryStream();

            let json = System.Text.Json.Utf8JsonWriter(buffer, _);

            json.write_start_object();
            json.write_string("text", text);

            if value? then
                json.write_string("value", value);
            fi

            if error? then
                json.write_string("error", error);
            fi

            json.write_end_object();

            json.flush();
            json.dispose();

            System.Text.Encoding.utf8.get_string(buffer.to_array())
        si
    si
si
